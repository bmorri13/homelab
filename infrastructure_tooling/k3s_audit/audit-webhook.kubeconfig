# Where the apiserver posts audit events: the falco-k8saudit Service (k8saudit plugin).
# The apiserver runs on the host and can't resolve cluster DNS, so the Service has a
# fixed ClusterIP (infrastructure_tooling/falco_k3s/values.yaml). Batch mode: if Falco
# is down the apiserver retries, then drops the batch; API requests are never blocked.
apiVersion: v1
kind: Config
clusters:
  - name: falco-k8saudit
    cluster:
      server: http://10.43.200.10:9765/k8s-audit
contexts:
  - name: default
    context:
      cluster: falco-k8saudit
      user: ""
current-context: default
preferences: {}
users: []

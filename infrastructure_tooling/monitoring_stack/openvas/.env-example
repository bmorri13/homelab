# OpenVAS / Greenbone Community Edition Configuration

# Admin password for the GSA web interface. Required: docker compose won't start without it.
# Use a long random value (e.g. openssl rand -base64 24).
GVM_ADMIN_PASSWORD=

# Feed release version (leave empty for latest)
GREENBONE_FEED_RELEASE=

# Web interface ports
GSA_PORT=9392
NGINX_HTTPS_PORT=443

# PostgreSQL settings
POSTGRES_DB=gvmd
POSTGRES_USER=gvmd
POSTGRES_PASSWORD=changeme

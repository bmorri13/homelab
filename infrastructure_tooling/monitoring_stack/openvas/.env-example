# OpenVAS / Greenbone Community Edition Configuration

# Admin password for the GSA web interface. Required: docker compose won't start without it.
# Use a long random value (e.g. openssl rand -base64 24).
GVM_ADMIN_PASSWORD=

# Address the web UI (port 9392) listens on. Default 127.0.0.1: reach it through an SSH tunnel.
# Set it to one of the host's own addresses to open it to that network.
GVM_BIND_ADDR=127.0.0.1

# Splunk homelab logging stack - copy to .env (git-ignored) and fill in.
# Generate values with: openssl rand -base64 24   /   uuidgen

# Admin password, applied on first start only (min 8 chars)
SPLUNK_PASSWORD=

# Default HEC token (UUID format)
SPLUNK_HEC_TOKEN=

# Host directory holding etc/ and var/ (indexed data). Lives on the root disk.
SPLUNK_DATA_DIR=/srv/splunk

# Host mount point of the Unraid NFS share (frozen archive + config backups)
SPLUNK_ARCHIVE_HOST_DIR=/mnt/unraid-splunk

# Container memory cap; the VM has 16 GB shared with other stacks
SPLUNK_MEM_LIMIT=10g

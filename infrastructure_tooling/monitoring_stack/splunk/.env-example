# Splunk + Cribl homelab logging stack - copy to .env (git-ignored), fill in, chmod 600.

# Splunk admin password, applied on first start only (min 8 chars). If you change it
# in the UI, update it here to match: the scripts log in with it.
#   openssl rand -base64 24
SPLUNK_PASSWORD=

# Cribl admin password, set by scripts/cribl-bootstrap.sh on first deploy.
# Needs 3 of: lowercase, uppercase, digits, symbols. If you change it in the UI,
# update it here to match: deploy.sh and the cribl-* scripts log in with it.
CRIBL_ADMIN_PASSWORD=

# Token the OTel collectors send to Cribl's HEC input (UUID format)
#   uuidgen
CRIBL_HEC_TOKEN=

# Shared secret the Cribl Worker uses to connect to the Leader (port 4200, compose
# network only). Changing it means recreating both containers.
#   openssl rand -hex 24
CRIBL_DIST_TOKEN=

# Host directories. All three live on the root disk.
SPLUNK_DATA_DIR=/srv/splunk
CRIBL_DATA_DIR=/srv/cribl
CRIBL_WORKER_DATA_DIR=/srv/cribl-worker

# Host mount point of the Unraid NFS share (config backups and the frozen archive)
SPLUNK_ARCHIVE_HOST_DIR=/mnt/unraid-splunk

# Container memory caps; the VM has 16 GB shared with other stacks
SPLUNK_MEM_LIMIT=8g
CRIBL_LEADER_MEM_LIMIT=3g
CRIBL_MEM_LIMIT=2g

# LAN address Splunk's management port (8089) is published on, for the MCP gateway
SPLUNK_MGMT_BIND=192.168.4.11

# Cribl Leader's compose network and fixed address (must be in 192.168.0.0/16 and
# unused on the LAN; tls-certs.sh puts the address in the Leader's cert)
CRIBL_LEADER_SUBNET=192.168.237.0/29
CRIBL_LEADER_IP=192.168.237.2

# Firewall allowlists (scripts/mgmt-firewall.sh): comma-separated CIDRs. Unset or
# empty uses the default shown; a value replaces it, so list every sender. Re-run the
# script to apply; it also reads these at boot.
#SPLUNK_MGMT_ALLOWED=192.168.4.98/32                    # 8089: k3s-01
#SPLUNK_WEB_ALLOWED=192.168.4.98/32                     # 8000: k3s-01
#CRIBL_UI_ALLOWED=192.168.4.98/32                       # 9000: k3s-01
#SYSLOG_NETWORK_ALLOWED=192.168.4.1/32,192.168.1.85/32  # 5514: UniFi gateways
#HEC_ALLOWED=192.168.4.0/24                             # 8443: server LAN

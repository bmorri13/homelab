# Installed by scripts/deploy.sh. Applies scripts/mgmt-firewall.sh before Docker
# starts, so the published Splunk and Cribl ports are never open to the LAN after a
# reboot.
[Unit]
Description=Restrict the published Splunk and Cribl ports (mgmt-firewall.sh)
Before=docker.service
Wants=network-pre.target
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/splunk-stack/scripts/mgmt-firewall.sh

[Install]
WantedBy=multi-user.target

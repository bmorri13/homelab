# One run of a homelab agent: homelab-agent@sec or homelab-agent@ops.
# Started by homelab-agent-sec.timer / homelab-agent-ops.timer; see ../README.md.
[Unit]
Description=Homelab %i agent run
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
User=homelab-agents
Group=homelab-agents
StateDirectory=homelab-agents
StateDirectoryMode=0700
WorkingDirectory=/var/lib/homelab-agents
Environment=HOME=/var/lib/homelab-agents
# The runner's Kubernetes token (root-only file); the service reads a private copy.
LoadCredential=runner.token:/etc/homelab-agents/runner.token
ExecStart=/opt/homelab-agents/venv/bin/python /opt/homelab-agents/app/runner.py %i
TimeoutStartSec=25min
Nice=10

# The agent has no local tools at all (tools=[]), but contain the process anyway.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077
